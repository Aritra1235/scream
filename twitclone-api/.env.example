PORT=3000

AXIOM_TOKEN=your-axiom-token
AXIOM_DATASET=TwitClone

BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Optional alias for the primary auth server URL:
# BETTER_AUTH_BASE_URL=http://localhost:3000
# Optional comma-separated browser origins trusted by Better Auth:
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001,https://app.example.com
# Optional extra URLs/origins related to Better Auth:
# BETTER_AUTH_URLS=http://localhost:3001,https://app.example.com

DATABASE_URL=postgresql://devuser:devpass@localhost:5432/twitclone

CDN_BASE_URL=https://cdn.example.com
DEFAULT_AVATAR_OBJECT=Twitter_default_profile_400x400.png
DEFAULT_BANNER_OBJECT=Twitter_default_banner_1500x500.jpg

AWS_ENDPOINT=https://s3.example.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET_NAME=your-bucket-name

# Primary frontend URL used for email links and redirects.
WEB_URL=http://localhost:3001
# Optional comma-separated frontend URLs.
WEB_URLS=http://localhost:3001,https://app.example.com
# Optional comma-separated CORS origins.
CORS_ORIGINS=http://localhost:3001,https://app.example.com
# Optional alias for the same setting.
# CORS_ALLOWED_ORIGINS=http://localhost:3001,https://app.example.com

MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.example.com
DONT_SEND_EMAIL=false
# Optional sender override:
# EMAIL_FROM=SCREAM <no-reply@example.com>

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jdev
