{
  "name": "twitclone-api",
  "version": "1.0.50",
  "scripts": {
    "test": "jest --forceExit --detectOpenHandles",
    "test:unit": "jest --forceExit --detectOpenHandles tests/unit",
    "test:e2e": "jest --forceExit --detectOpenHandles tests/e2e",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --compile src/index.ts --outfile build/twitclone-api",
    "start": "./build/twitclone-api",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.927.0",
    "@aws-sdk/s3-request-presigner": "^3.927.0",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/openapi": "^1.4.11",
    "@elysiajs/opentelemetry": "^1.4.6",
    "better-auth": "^1.3.34",
    "drizzle-orm": "^0.44.7",
    "elysia": "latest",
    "mailgun.js": "^12.1.1",
    "neo4j-driver": "^6.0.1",
    "pg": "^8.11.3",
    "postgres": "^3.4.7",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.0",
    "bun-types": "latest",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.6",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6"
  },
  "module": "src/index.js"
}
