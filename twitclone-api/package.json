{
  "name": "twitclone-api",
  "version": "1.0.50",
  "scripts": {
    "test": "jest --forceExit --detectOpenHandles",
    "test:unit": "jest --forceExit --detectOpenHandles tests/unit",
    "test:e2e": "jest --forceExit --detectOpenHandles tests/e2e",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --compile src/index.ts --outfile build/twitclone-api",
    "start": "./build/twitclone-api",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "script:db-stats": "bun run scripts/db-stats.ts",
    "script:db-seed": "bun run scripts/db-seed.ts",
    "script:db-reset": "bun run scripts/db-reset.ts",
    "script:neo4j-status": "bun run scripts/neo4j-status.ts",
    "script:neo4j-seed": "bun run scripts/neo4j-seed.ts",
    "script:neo4j-reset": "bun run scripts/neo4j-reset.ts",
    "script:neo4j-query": "bun run scripts/neo4j-query.ts",
    "script:user-list": "bun run scripts/user-list.ts",
    "script:user-get": "bun run scripts/user-get.ts",
    "script:user-create": "bun run scripts/user-create.ts",
    "script:user-verify": "bun run scripts/user-verify.ts",
    "script:user-onboard": "bun run scripts/user-onboard.ts",
    "script:user-delete": "bun run scripts/user-delete.ts",
    "script:posts-list": "bun run scripts/posts-list.ts",
    "script:posts-create": "bun run scripts/posts-create.ts",
    "script:posts-delete": "bun run scripts/posts-delete.ts",
    "script:feed-debug": "bun run scripts/feed-debug.ts",
    "script:follow-manage": "bun run scripts/follow-manage.ts",
    "script:graph-sync": "bun run scripts/graph-sync.ts",
    "script:graph-recommendations": "bun run scripts/graph-recommendations.ts",
    "script:graph-trending": "bun run scripts/graph-trending.ts",
    "script:sessions-cleanup": "bun run scripts/sessions-cleanup.ts",
    "script:counters-recount": "bun run scripts/counters-recount.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.927.0",
    "@aws-sdk/s3-request-presigner": "^3.927.0",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/openapi": "^1.4.11",
    "@elysiajs/opentelemetry": "^1.4.6",
    "better-auth": "^1.3.34",
    "drizzle-orm": "^0.44.7",
    "elysia": "latest",
    "mailgun.js": "^12.1.1",
    "neo4j-driver": "^6.0.1",
    "pg": "^8.11.3",
    "postgres": "^3.4.7",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.0",
    "bun-types": "latest",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.6",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6"
  },
  "module": "src/index.js"
}
